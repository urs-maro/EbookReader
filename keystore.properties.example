# Copiază acest fișier ca `keystore.properties` (în rădăcina proiectului) și completează
# valorile tale. NU comite niciodată fișierul real — e deja ignorat de git (.gitignore).
#
# storeFile   = calea către keystore, relativă la rădăcina proiectului
# storePassword = parola keystore-ului
# keyAlias    = numele (alias) cheii din keystore
# keyPassword = parola cheii

storeFile=crio-release.jks
storePassword=SCHIMBA_PAROLA_KEYSTORE
keyAlias=crio
keyPassword=SCHIMBA_PAROLA_CHEIE
